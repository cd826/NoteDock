{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteDock",
  "version": "0.1.0",
  "identifier": "com.notetock.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteDock",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Markdown 文档",
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown"
      },
      {
        "name": "纯文本文档",
        "ext": [
          "txt"
        ],
        "mimeType": "text/plain"
      },
      {
        "name": "SQL 脚本",
        "ext": [
          "sql"
        ],
        "mimeType": "application/sql"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}